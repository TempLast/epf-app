{
  "name": "epf-app",
  "version": "0.1.0",
  "description": "Application d'exemple pour les modules CI/CD — EPF Bachelor 3",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "node --test",
    "test:junit": "node --test --test-reporter=junit --test-reporter-destination=test-results.xml",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
